# The variables this app reads at runtime on the VPS. Names only; never put values here.
# Each one needs two things:
#   - a repo secret (or, if it isn't secret, a repo variable) named ENV_<NAME>, and
#   - a matching line in the "Write .env" step of .github/workflows/build-and-deploy.yml.
# ENV_JWT_SECRET below becomes JWT_SECRET in the .env the deploy writes on the VPS.

# Required. Signs Postiz's login tokens (secret). Changing it signs everyone out.
JWT_SECRET=
# Required. Password of the database's postiz user, which Temporal also uses (secret). Letters and digits
# only: it goes into a connection URL. Postgres only reads it when the db-data volume is first created,
# so changing it later locks the app out of its database.
POSTGRES_PASSWORD=

# Optional, a variable. true (the default) stops password sign-up once the first account exists. Set it to
# false only while teammates accept their invites, then set it back. See "Accounts" in the README.
DISABLE_REGISTRATION=

# Each social channel needs its own developer app; a channel stays unavailable until its settings are set.
# See https://docs.postiz.com/providers for how to create each app. The redirect URI for every provider is
# https://social.flyindycenter.com/integrations/social/<provider>.
# Discord: an application with a bot (client id and secret, and the bot token; all secret).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN_ID=
# YouTube: a Google Cloud OAuth client with the YouTube Data API enabled (secret).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Facebook Pages, and Instagram business accounts linked to a Page: a Meta app (secret).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
